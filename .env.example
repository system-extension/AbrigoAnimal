# Copie para ".env" e preencha. O ".env" NÃO vai para o Git.

# Banco (em desenvolvimento, o compose.yaml sobe um Postgres com estes valores, na porta 5433)
DB_URL=jdbc:postgresql://localhost:5433/abrigo
DB_USER=abrigo
DB_PASSWORD=abrigo

# Primeiro usuário (criado só se o banco não tiver nenhum usuário)
ADMIN_NOME=Administrador
ADMIN_EMAIL=
ADMIN_SENHA=

# Endereço público do site (usado nas prévias do WhatsApp)
URL_PUBLICA=http://localhost:8080

# Onde as fotos são gravadas (implementação local, até decidir a hospedagem)
ARMAZENAMENTO_DIR=./dados/arquivos

# Produção: true (cookie só trafega em HTTPS)
COOKIE_SECURE=false

# Antispam do formulário público
SOLICITACOES_LIMITE_HORA=5

# De onde vem o IP do visitante (bloqueio de login e antispam). Local: CONEXAO.
# Produção: definir DEPOIS de medir o proxy do Railway (docs/producao.md).
# Opções: CONEXAO, X_FORWARDED_FOR_ULTIMO, X_FORWARDED_FOR_PRIMEIRO, X_REAL_IP
IP_CLIENTE_MODO=CONEXAO
# true só durante a medição: registra no log os cabeçalhos de IP recebidos
IP_CLIENTE_DIAGNOSTICO=false
